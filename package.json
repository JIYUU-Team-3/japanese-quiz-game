{
	"name": "japanese-quiz-game",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@11.23.0",
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types --check && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint . && cspell lint --no-progress --gitignore \"**/*\"",
		"format": "prettier --write .",
		"spell": "cspell lint --no-progress --gitignore \"**/*\"",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"preview:ci": "wrangler dev .svelte-kit/cloudflare/_worker.js --local --port 4173",
		"gen": "wrangler types",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:seed:gen": "node --experimental-strip-types scripts/generate-seed.ts > drizzle/seed.sql",
		"db:reset:local": "wrangler d1 execute quizdb --local --file=drizzle/0000_init_quiz_schema.sql && wrangler d1 execute quizdb --local --file=drizzle/0001_nullable_session_player.sql && wrangler d1 execute quizdb --local --file=drizzle/seed.sql",
		"db:seed:local": "wrangler d1 execute quizdb --local --file=drizzle/seed.sql",
		"db:seed:remote": "wrangler d1 execute quizdb --remote --file=drizzle/seed.sql"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.18.2",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "next",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.8",
		"cspell": "^10.1.1",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"lefthook": "^2.1.12",
		"playwright": "^1.62.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1",
		"wrangler": "^4.97.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
