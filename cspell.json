{
	"$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
	"version": "0.2",
	"language": "en,en-GB",
	"useGitignore": true,
	"caseSensitive": false,
	"allowCompoundWords": false,
	"dictionaries": [
		"typescript",
		"node",
		"npm",
		"html",
		"css",
		"bash",
		"softwareTerms",
		"filetypes"
	],
	"ignorePaths": [
		".git/**",
		".svelte-kit/**",
		".wrangler/**",
		"node_modules/**",
		"build/**",
		"playwright-report/**",
		"blob-report/**",
		"test-results/**",
		"src/lib/paraglide/**",
		"project.inlang/cache/**",
		"worker-configuration.d.ts",
		"drizzle/seed.sql",
		"pnpm-lock.yaml",
		"package-lock.json",
		"*.svg",
		"cspell.json"
	],
	"ignoreRegExpList": [
		"/[\\u3000-\\u303f\\u3040-\\u309f\\u30a0-\\u30ff\\u4e00-\\u9fff\\u3400-\\u4dbf\\uff00-\\uffef]+/g",
		"/\\b[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\\b/g"
	],
	"words": [
		"cadt",
		"drizzle",
		"dbaeumer",
		"esbenp",
		"furigana",
		"hiragana",
		"inlang",
		"jiyuu",
		"jlpt",
		"kanji",
		"katakana",
		"kenjougo",
		"nihongo",
		"paraglide",
		"pnpm",
		"quizdb",
		"rescores",
		"romaji",
		"runes",
		"scanline",
		"scanlines",
		"sonarcloud",
		"sonarqube",
		"subsetting",
		"svelte",
		"sveltekit",
		"unixepoch",
		"vitest",
		"washi",
		"wordmark",
		"workerd",
		"wrangler"
	],
	"ignoreWords": [
		"autoincrement",
		"chromium",
		"delocalize",
		"nodejs",
		"outdir",
		"reroute",
		"sqlite",
		"tsconfig"
	],
	"languageSettings": [
		{
			"languageId": "markdown",
			"ignoreRegExpList": ["/^\\s*```[\\s\\S]*?^\\s*```/gm", "/`[^`\\n]+`/g"]
		}
	],
	"overrides": [
		{
			"filename": ["drizzle/**/*.sql", "drizzle/meta/**"],
			"dictionaries": ["sql"]
		}
	]
}
